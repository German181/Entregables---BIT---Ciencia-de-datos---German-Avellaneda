   "source": [
    "\n",
    "import statsmodels.api as sm\n",
    "especies = ['red squirrel','hedgehog','lynx','European bison']\n",
    "\n",
    "for especie in especies:\n",
    "    ani_copia = animales[animales['Animal type']==especie].copy()\n",
    "    # regresion logaritmica (relación arometrica: log(peso) = log(a)+ b * log(longitud))\n",
    "    x = np.log(ani_copia['Body Length cm'])\n",
    "    x = sm.add_constant(x) #añade la intersección (log a)\n",
    "    y = np.log(ani_copia['Weight kg'])\n",
    "\n",
    "    # ajustar la regresión lineal\n",
    "    modelo = sm.OLS(y, x).fit()\n",
    "     # Obtener el exponente alométrico real 'b' para esta especie\n",
    "    b = modelo.params[\"Body Length cm\"]\n",
    "    print(f\"Especie: {especie:15} | Exponente alométrico (b) calculado: {b:.4f}\")\n",
    "\n",
    "    # Calcular el Peso Estimado por el modelo de la población\n",
    "    a = np.exp(modelo.params[\"const\"])\n",
    "    peso_estimado = a * (ani_copia[\"Body Length cm\"] ** b)\n",
    "\n",
    "    # Calcular Kn = Peso Real / Peso Estimado\n",
    "    # (Si Kn > 1, el animal está más gordo/sano que el promedio de su especie)\n",
    "    animales.loc[animales[\"Animal type\"] == especie, \"Factor_condicion_Kn\"] = (\n",
    "    ani_copia[\"Weight kg\"] / peso_estimado\n",
    "    )\n",
    "# 3. Clasificar el estado de salud nutricional de cada individuo\n",
    "\n",
    "kn = animales[\"Factor_condicion_Kn\"]\n",
    "\n",
    "animales[\"clasificacion_salud\"] = np.where(\n",
    "    kn > 1.05, \"Buena (Por encima del promedio)\",\n",
    "    np.where(\n",
    "        kn >= 0.95, \"Normal\",\n",
    "        np.where(kn < 0.95, \"Pobre (Bajo peso)\", \"Sin datos\")\n",
    "    )\n",
    ")\n",
    "\n",
    "animales"
   ]
  },
