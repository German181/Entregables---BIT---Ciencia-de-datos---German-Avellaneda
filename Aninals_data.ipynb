   "source": [
    "# Calcular la mediana de a longitudes de animales faltantes por pais\n",
    "for _, fila in longitud.iterrows():\n",
    "    tipo_animal = fila['Animal type']\n",
    "    pais = fila['Country']\n",
    "\n",
    "    valores = animales.loc[(animales['Animal type'] == tipo_animal) & \n",
    "                           (animales['Country'] == pais), 'Body Length cm']\n",
    "\n",
    "    if valores.notna().sum() == 0:\n",
    "        print(f'Sin valores validos: {tipo_animal} - {pais}')\n",
    "\n",
    "    print(\n",
    "        tipo_animal,\n",
    "        pais,\n",
    "        'Valores válidos:', valores.notna().sum(),\n",
    "        'Mediana:', valores.median()\n",
    "    )"
   ]
  },
