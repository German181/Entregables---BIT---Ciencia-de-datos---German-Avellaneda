      "red squirrel Poland 22.0\n",
      "hedgehog Hungary 19.0\n",
      "red squirrel Hungary 19.5\n"
     ]
    }
   ],
   "source": [
    "# Reemplazar en los valores nulos la mediana\n",
    "for _, fila in longitud.iterrows():\n",
    "    tipo_animal = fila['Animal type']\n",
    "    pais = fila['Country']\n",
    "\n",
    "    mediana = animales.loc[(animales['Animal type'] == tipo_animal) & \n",
    "                           (animales['Country'] == pais), 'Body Length cm'].median()\n",
    "\n",
    "    animales.loc[\n",
    "        (animales['Animal type'] == tipo_animal) &\n",
    "        (animales['Country'] == pais) &\n",
    "        (animales['Body Length cm'].isna()), 'Body Length cm']=mediana\n",
    "\n",
    "    print(tipo_animal, pais, mediana)"
   ]
  },
