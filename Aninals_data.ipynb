   "source": [
    "agregaciones = dict(\n",
    "                    Factor_condicion_Kn=('Factor_condicion_Kn','median'),\n",
    "                    cantidad=('Factor_condicion_Kn','count')    \n",
    "                    )\n",
    "\n",
    "# Detalle por especie y país\n",
    "detalle = animales.groupby(['Animal type','Country'], as_index=False).agg(**agregaciones)\n",
    "# 2. subtotal por especie\n",
    "subtotal = animales.groupby('Animal type',as_index=False).agg(**agregaciones)\n",
    "subtotal['Country'] = 'Subtotal'\n",
    "# 3. Tabla final\n",
    "\n",
    "mediana = pd.concat([detalle,subtotal],ignore_index=True)\n",
    "mediana['orden'] = (mediana['Country']=='Subtotal').astype(int)\n",
    "mediana = (\n",
    "    mediana\n",
    "    .sort_values(['Animal type','orden','Country'])\n",
    "    .drop(columns='orden')\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "# 4. Clasificación\n",
    "kn = mediana['Factor_condicion_Kn']\n",
    "\n",
    "mediana['clasificacion_salud']= np.where(\n",
    "    kn > 1.05, \"Buena (Por encima de lo esperado)\",\n",
    "    np.where(\n",
    "        kn >= 0.95, \"Normal\",\n",
    "        np.where(kn < 0.95, \"Pobre (Bajo peso)\", \"Sin datos\")\n",
    "    )\n",
    ")\n",
    "mediana"
   ]
